{
  "name": "jev-orchestrator",
  "version": "0.1.0",
  "description": "Filter first, write agents second. Composio triggers bring in email, form leads and X mentions; Jev (TypeSafe System One) sorts each one; only the matched bucket runs a write agent; unsure waits for you. A live flowchart in the browser shows it happening.",
  "type": "module",
  "bin": {
    "jev-orchestrator": "./bin/jev-orchestrator.js"
  },
  "scripts": {
    "start": "node bin/jev-orchestrator.js",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@composio/core": "0.18.1",
    "@radix-ui/colors": "^3.0.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "files": [
    "bin",
    "src",
    "web/dist",
    "knowledge",
    "README.md"
  ]
}
