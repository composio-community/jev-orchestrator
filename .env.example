# Copy this file to .env and fill in the values.
# `npx jev-orchestrator setup` asks for the two required keys and writes them for you.
# Keep .env out of git. The .gitignore already does this.

# Required. Runs every connection: Gmail, Typeform, Slack, Discord and X.
# Get it from https://platform.composio.dev under Settings, API keys.
COMPOSIO_API_KEY=

# Required. Runs Jev and the write agents.
# Get it from https://openrouter.ai/keys, and put a spend limit on it.
OPENROUTER_API_KEY=

# Optional, and only for X.
# Composio has no shared X app, so X needs your own developer app.
# Go to https://developer.x.com, open your app, and read the Keys and tokens page.
# In the user authentication settings of that app, add this callback URL:
#   https://backend.composio.dev/api/v1/auth-apps/add
# With these three values set, the X panel creates the connection in one click.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
